# Ara M1 — Sendblue only. No Google, AI, or Resy credentials needed yet.
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
# Generate a random secret (at least 32 chars); configure the same value on the receive webhook.
SENDBLUE_WEBHOOK_SECRET=
# Your Sendblue number in E.164 format.
SENDBLUE_PHONE_NUMBER=
# Comma-separated exact group_id values. Empty denies all groups. IDs need not be UUIDs.
SENDBLUE_ALLOWED_GROUP_IDS=
# Fresh provider-specific database. Do not point this at the old ara.db or hangout.db.
ARA_DATABASE_PATH=./data/ara-sendblue.db
