# Ara M1 — Sendblue only. No Google, AI, or Resy credentials needed yet.
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
# Generate a random secret (at least 32 chars); configure the same value on the receive webhook.
SENDBLUE_WEBHOOK_SECRET=
# Your Sendblue number in E.164 format.
SENDBLUE_PHONE_NUMBER=
# Comma-separated exact group_id values. Empty denies all groups. IDs need not be UUIDs.
SENDBLUE_ALLOWED_GROUP_IDS=
# Fresh provider-specific database. Do not point this at the old ara.db or hangout.db.
ARA_DATABASE_PATH=./data/ara-sendblue.db

# M2 is opt-in. Leave false to keep the verified M1 messaging behavior.
ARA_AI_ENABLED=false
ARA_BOOKINGS_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ARA_BOOKING_OWNER=
ARA_PILOT_CITY=
ARA_ALLOWED_LOCALITIES=
ARA_TIME_ZONE=America/New_York
ARA_LATITUDE=
ARA_LONGITUDE=
# Generated by npm run resy -- init-key. Never commit or share this key.
ARA_CREDENTIAL_KEY=
# From your own authenticated Resy session; see docs/RESY_SETUP.md.
RESY_API_KEY=
# Never put the Resy auth token here; npm run resy -- connect stores it encrypted.

# Isolated Steel browser fallback. No local Chrome or personal profile is used.
STEEL_API_KEY=
ARA_BROWSER_ENABLED=false
ARA_RESY_CITY_SLUG=new-york-ny
ARA_BROWSER_DOM_LLM=true
ARA_BROWSER_SCREENSHOTS=false
ARA_BROWSER_DAILY_MODEL_CALLS=10
